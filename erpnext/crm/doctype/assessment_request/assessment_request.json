 "fields": [
  {
   "default": "ASR-.YYYY.-",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "hidden": 1,
   "label": "Series",
   "options": "ASR-.YYYY.-",
   "reqd": 1
  },
  {
   "default": "Open",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Open\nIn Progress\nClosed\nConverted to Application"
  },
  {
   "fieldname": "assigned_team",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Assigned Team",
   "options": "Team",
   "read_only": 1
  },
  {
   "fieldname": "column_break_meta",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "Requested By",
   "options": "User",
   "read_only": 1
  },
  {
   "default": "Today",
   "fieldname": "request_date",
   "fieldtype": "Date",
   "label": "Request Date",
   "read_only": 1
  },
  {
   "fieldname": "student_section",
   "fieldtype": "Section Break",
   "label": "Student Information"
  },
  {
   "fieldname": "student_already_registered",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Student Already Registered",
   "options": "\nYes\nNo",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.student_already_registered == 'Yes'",
   "fieldname": "student",
   "fieldtype": "Link",
   "label": "Student ID / Student Name",
   "options": "Student",
   "mandatory_depends_on": "eval:doc.student_already_registered == 'Yes'"
  },
  {
   "fieldname": "column_break_student",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "first_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "First Name",
   "reqd": 1
  },
  {
   "fieldname": "middle_name",
   "fieldtype": "Data",
   "label": "Middle Name"
  },
  {
   "fieldname": "last_name",
   "fieldtype": "Data",
   "label": "Last Name"
  },
  {
   "fieldname": "mobile_number",
   "fieldtype": "Data",
   "label": "Mobile Number",
   "mandatory_depends_on": "eval:doc.student_already_registered == 'Yes' || doc.student_already_registered == 'No'",
   "options": "Phone"
  },
  {
   "fieldname": "email_address",
   "fieldtype": "Data",
   "label": "Email Address",
   "mandatory_depends_on": "eval:doc.student_already_registered == 'Yes' || doc.student_already_registered == 'No'",
   "options": "Email"
  },
  {
   "fieldname": "preferences_section",
   "fieldtype": "Section Break",
   "label": "Additional Information"
  },
  {
   "fieldname": "preferred_countries",
   "fieldtype": "Table MultiSelect",
   "label": "Preferred Countries",
   "options": "Assessment Request Country",
   "reqd": 1,
   "description": "Pick one or more destination countries."
  },
  {
   "fieldname": "preferred_course_area",
   "fieldtype": "Data",
   "label": "Preferred Course Area",
   "reqd": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "depends_on": "eval:doc.student_already_registered == 'No'",
   "fieldname": "attachments_section",
   "fieldtype": "Section Break",
   "label": "Attach Documents"
  },
  {
   "depends_on": "eval:doc.student_already_registered == 'No'",
   "fieldname": "attachments",
   "fieldtype": "Table",
   "label": "Documents",
   "options": "Assessment Request Document"
  },
  {
   "depends_on": "eval:in_list(frappe.user_roles, 'CRO') || in_list(frappe.user_roles, 'CRO Head') || in_list(frappe.user_roles, 'System Manager') || in_list(frappe.user_roles, 'CRM Admin')",
   "fieldname": "cro_unregistered_section",
   "fieldtype": "Section Break",
   "label": "Agent / Agency",
   "description": "Optional. Lets a CRO record which agent and agency the request came in through. Hidden from agents, who are the source themselves."
  },
  {
   "depends_on": "eval:in_list(frappe.user_roles, 'CRO') || in_list(frappe.user_roles, 'CRO Head') || in_list(frappe.user_roles, 'System Manager') || in_list(frappe.user_roles, 'CRM Admin')",
   "fieldname": "cro_agent_name",
   "fieldtype": "Link",
   "options": "Agent",
   "label": "Agent Name"
  },
  {
   "depends_on": "eval:in_list(frappe.user_roles, 'CRO') || in_list(frappe.user_roles, 'CRO Head') || in_list(frappe.user_roles, 'System Manager') || in_list(frappe.user_roles, 'CRM Admin')",
   "fieldname": "cro_agency_name",
   "fieldtype": "Data",
   "label": "Agency Name",
   "fetch_from": "cro_agent_name.company_name",
   "fetch_if_empty": 1,
   "description": "Auto-filled from the selected agent's company; can be overridden."
  },
  {
   "fieldname": "assessment_workflow_tab",
   "fieldtype": "Tab Break",
   "label": "Assessment Workflow"
  },
  {
   "description": "Only Admissions can set this. When Yes, the Assessment Vendors grid appears for CRO / staff.",
   "fieldname": "need_assessment",
   "fieldtype": "Select",
   "label": "Need Assessment?",
   "options": "\nYes\nNo"
  },
  {
   "depends_on": "eval:doc.need_assessment == 'Yes'",
   "fieldname": "assessment_vendors_section",
   "fieldtype": "Section Break",
   "label": "Assessment Grid"
  },
  {
   "depends_on": "eval:doc.need_assessment == 'Yes'",
   "description": "Backend team tracks assessment receipt, student options, confirmation, and conversion here.",
   "fieldname": "assessment_vendors",
   "fieldtype": "Table",
   "label": "Assessment Vendors",
   "options": "Need Assessment Vendor"
  },
  {
   "depends_on": "eval:doc.need_assessment == 'Yes'",
   "fieldname": "course_shortlisting_section",
   "fieldtype": "Section Break",
   "label": "Course Shortlisting"
  },
  {
   "depends_on": "eval:doc.need_assessment == 'Yes'",
   "description": "Admissions / CRO shortlist courses here. University, country and tuition fee fill in from the selected course; set the intake date manually. Once submitted, the agent sees this table and can apply from any row.",
   "fieldname": "course_shortlisting",
   "fieldtype": "Table",
   "label": "Course Shortlisting (Assessment Request Responses)",
   "options": "Assessment Course Shortlisting"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.need_assessment == 'Yes'",
   "fieldname": "response_submitted",
   "fieldtype": "Check",
   "label": "Response Submitted",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.response_submitted",
   "fieldname": "response_submitted_on",
   "fieldtype": "Datetime",
   "label": "Response Submitted On",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.response_submitted",
   "fieldname": "response_submitted_by",
   "fieldtype": "Link",
   "label": "Response Submitted By",
   "options": "User",
   "read_only": 1
  }
 ],
